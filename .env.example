# ---------------------------------------------------------------------------
# GitHub Agent Dispatcher configuration
# Copy to `.env` (or set the equivalent variables in your environment / Service /
# launchd plist) and fill in your own values. Never commit your real .env.
# ---------------------------------------------------------------------------

# --- GitHub ---------------------------------------------------------------
# Personal access token (classic, or fine-grained PAT with contents:read/write,
# issues:read/write, pull_requests:read/write metadata permissions).
# Required.
GITHUB_TOKEN=

# Base URLs; only change GITHUB_API_URL for GitHub Enterprise.
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Which repositories can be worked on. Required when REPOSITORY_DISCOVERY=configured.
# Comma-separated "owner/repo" pairs.
GITHUB_ALLOWED_REPOS=owner/repo1,owner/repo2

# Which GitHub users may trigger agent work. Comma-separated logins.
# Default: empty => only the token owner (if GITHUB_ALLOW_SELF=true).
GITHUB_ALLOWED_USERS=

# Allow the token owner (you) to trigger work even when not listed in
# GITHUB_ALLOWED_USERS.
GITHUB_ALLOW_SELF=true

# --- Repository discovery -------------------------------------------------
# configured - only monitor GITHUB_ALLOWED_REPOS (safest).
# owned      - auto-discover repositories owned by the token user; still
#              intersected with GITHUB_ALLOWED_REPOS when one is set.
REPOSITORY_DISCOVERY=configured

# Which new Issues become agent jobs. Comma-separated:
#   mention      - Issue title/body contains AGENT_TRIGGER (default)
#   assigned     - Issue is assigned to an authorized user
#   label:agent  - Issue has the `agent` label
#   any          - every new open issue from an authorized user
#   none         - never auto-process Issues (comments only)
ISSUE_DISCOVERY=mention

# --- Work triggers ---------------------------------------------------------
# Text that turns a comment / issue into a job. "@agent" by default.
AGENT_TRIGGER=@agent

# --- Agent backend ---------------------------------------------------------
# Command used to invoke OpenCode in non-interactive mode. The full prompt is
# passed as the trailing argument(s). Customize if opencode is not on PATH.
AGENT_COMMAND=opencode run

# Optional extra flags appended before the prompt (e.g. --model or --agent).
AGENT_EXTRA_ARGS=

# --- Workspace -------------------------------------------------------------
# Root directory for local repository checkouts.
# macOS example:      /Users/you/Codebase
# Windows example:    C:\Codebase
WORKSPACE_ROOT=

# Clone approved repositories automatically if they are not present locally.
AUTO_CLONE=true

# After an Issue job succeeds, open a pull request from the agent branch.
# OFF by default; set to true to enable.
AUTO_CREATE_PR=false

# --- Polling ---------------------------------------------------------------
POLL_INTERVAL_SECONDS=300

# --- Validation ------------------------------------------------------------
# Commands run after the agent finishes, BEFORE any commit/push is performed.
# Comma- or newline-separated. Never put anything here that is derived from
# GitHub input! This is YOUR controlled list only.
#VALIDATION_COMMANDS=pytest
#VALIDATION_COMMANDS=ruff check ., npm test
#VALIDATION_COMMANDS=go test ./...

# --- State -----------------------------------------------------------------
DATABASE_PATH=
# Default: .state/state.db inside the project (gitignored).
# Redirect, e.g.: DATABASE_PATH=~/.github-agent-dispatcher/state.db

MAX_CONCURRENT_JOBS=2

LOG_LEVEL=INFO

# --- Settings only used by advanced local configuration --------------------
# Optional per-repository overrides via a JSON config file:
#   .state/config.json   (or ~/.github-agent-dispatcher/config.json)
#   {
#     "repositories": {
#       "owner/repo": {
#         "validation_commands": ["pytest", "ruff check ."],
#         "agent_command": "opencode run --model claude"
#       }
#     }
#   }
GAD_CONFIG_FILE=
GAD_DATA_DIR=
# Default: .state in the project root (gitignored). Holds state.db, locks/, config.json.